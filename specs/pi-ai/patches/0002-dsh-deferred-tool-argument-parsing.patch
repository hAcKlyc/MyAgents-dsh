diff --git a/packages/ai/test/dsh-tool-argument-streaming.test.ts b/packages/ai/test/dsh-tool-argument-streaming.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..daf7050ac42d7d864fe44055eac8b48453c64ed3
--- /dev/null
+++ b/packages/ai/test/dsh-tool-argument-streaming.test.ts
@@ -0,0 +1,66 @@
+import { describe, expect, it } from "vitest";
+import type { AssistantMessageEvent, Model } from "../src/types.ts";
+import { stream as anthropic } from "../src/api/anthropic-messages.ts";
+import { stream as completions } from "../src/api/openai-completions.ts";
+import { stream as responses } from "../src/api/openai-responses.ts";
+import { normalizeContext } from "../src/utils/transcript.ts";
+
+const args = { file_path: "notes.md", content: "x".repeat(2048) };
+const json = JSON.stringify(args);
+const fragments = json.match(/.{1,7}/gs) ?? [];
+const context = normalizeContext({ messages: [{ role: "user", content: "fixture", timestamp: 0 }] });
+const model = <A extends "anthropic-messages" | "openai-completions" | "openai-responses">(api: A): Model<A> => ({
+  id: "fixture", name: "fixture", api, provider: "fixture", baseUrl: "https://fixture.invalid/v1", reasoning: false,
+  input: ["text"], cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 }, contextWindow: 8192, maxTokens: 4096,
+});
+const response = (events: unknown[], named = false) => new Response(events.map(event =>
+  `${named ? `event: ${(event as { type: string }).type}\n` : ""}data: ${typeof event === "string" ? event : JSON.stringify(event)}\n\n`,
+).join(""), { headers: { "content-type": "text/event-stream" } });
+async function check(events: AsyncIterable<AssistantMessageEvent>) {
+  const partials: unknown[] = [];
+  let final: unknown;
+  for await (const event of events) {
+    if (event.type === "toolcall_delta" && event.delta.length > 0) {
+      const block = event.partial.content[event.contentIndex];
+      partials.push(block?.type === "toolCall" ? structuredClone(block.arguments) : undefined);
+    } else if (event.type === "toolcall_end") final = event.toolCall.arguments;
+    else if (event.type === "error") throw new Error(event.error.errorMessage);
+  }
+  expect(partials).toHaveLength(fragments.length);
+  expect(partials.every(value => JSON.stringify(value) === "{}")).toBe(true);
+  expect(final).toEqual(args);
+}
+describe("DSH deferred tool argument parsing", () => {
+  it("parses Anthropic client tool arguments at the terminal edge", async () => {
+    const events = [
+      { type: "message_start", message: { id: "msg_1", type: "message", role: "assistant", model: "fixture", content: [], stop_reason: null, usage: { input_tokens: 1, output_tokens: 0 } } },
+      { type: "content_block_start", index: 0, content_block: { type: "tool_use", id: "toolu_1", name: "write", input: {} } },
+      ...fragments.map(partial_json => ({ type: "content_block_delta", index: 0, delta: { type: "input_json_delta", partial_json } })),
+      { type: "content_block_stop", index: 0 },
+      { type: "message_delta", delta: { stop_reason: "tool_use" }, usage: { output_tokens: 1 } },
+      { type: "message_stop" },
+    ];
+    await check(anthropic(model("anthropic-messages"), context, { apiKey: "fixture-key", fetch: async () => response(events, true) }));
+  });
+  it("parses Completions client tool arguments at the terminal edge", async () => {
+    const events = [
+      { choices: [{ delta: { role: "assistant", tool_calls: [{ index: 0, id: "call_1", type: "function", function: { name: "write", arguments: "" } }] }, index: 0, finish_reason: null }] },
+      ...fragments.map(fragment => ({ choices: [{ delta: { tool_calls: [{ index: 0, function: { arguments: fragment } }] }, index: 0, finish_reason: null }] })),
+      { choices: [{ delta: {}, index: 0, finish_reason: "tool_calls" }], usage: { prompt_tokens: 1, completion_tokens: 1 } },
+      "[DONE]",
+    ];
+    await check(completions(model("openai-completions"), context, { apiKey: "fixture-key", fetch: async () => response(events) }));
+  });
+  it("parses Responses client tool arguments at the terminal edge", async () => {
+    const item = { type: "function_call", call_id: "call_1", id: "fc_1", name: "write" };
+    const events = [
+      { type: "response.created", response: { id: "resp_1" } },
+      { type: "response.output_item.added", output_index: 0, item: { ...item, arguments: "" } },
+      ...fragments.map(delta => ({ type: "response.function_call_arguments.delta", output_index: 0, delta })),
+      { type: "response.function_call_arguments.done", output_index: 0, arguments: json },
+      { type: "response.output_item.done", output_index: 0, item: { ...item, arguments: json } },
+      { type: "response.completed", response: { id: "resp_1", status: "completed", output: [], usage: { input_tokens: 1, output_tokens: 1, total_tokens: 2 } } },
+    ];
+    await check(responses(model("openai-responses"), context, { apiKey: "fixture-key", fetch: async () => response(events) }));
+  });
+});
