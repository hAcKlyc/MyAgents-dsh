+function sumOptionalUsage(
+  left: TokenUsage,
+  right: TokenUsage,
+  key: 'cacheReadTokens' | 'cacheWriteTokens' | 'reasoningTokens' | 'totalTokens',
+): Partial<TokenUsage> {
+  const first = left[key]
+  const second = right[key]
+  if (first === undefined || second === undefined) return {}
+  const value = first + second
+  return Number.isSafeInteger(value) && value >= 0 ? { [key]: value } : {}
