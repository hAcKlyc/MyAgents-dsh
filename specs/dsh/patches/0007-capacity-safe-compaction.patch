+/**
+ * Select the largest older balanced prefix whose exact summary request fits a
+ * resolved input budget. This is read-only and runs before the durable start.
+ * @param session - authoritative current surface and request envelope.
+ * @param start - requested inclusive start boundary.
+ * @param end - requested inclusive maximum end boundary.
+ * @param estimateInput - singleton-meter estimate of the exact summary request.
+ * @param inputBudget - resolved summary target input budget.
+ * @returns the largest fitting range and estimate, or `null` when no legal unit fits.
+ */
+export function fitCompactableRange(
+  session: Session,
+  start: SessionSeq,
+  end: SessionSeq,
+  estimateInput: (input: SummarizationInput) => number,
+  inputBudget: number,
+): { start: SessionSeq; end: SessionSeq; inputTokens: number; nodes: number } | null {
+  const requested = validateSurfaceRegion(session, start, end)
+  const surface = session.surface.nodes
+  for (let endIdx = requested.endIdx; endIdx >= requested.startIdx; endIdx -= 1) {
+    // oxlint-disable-next-line typescript/no-non-null-assertion
+    const candidateEnd = surface[endIdx]!
+    if (!toolPairingBalancedAfter(session, candidateEnd)) continue
+    const shadowedSeqs = surface.slice(requested.startIdx, endIdx + 1)
+    const input = buildSummarizationInput(session, shadowedSeqs)
+    const inputTokens = estimateInput(input)
+    if (inputTokens <= inputBudget) {
+      return {
+        start,
+        end: candidateEnd,
+        inputTokens,
+        nodes: shadowedSeqs.length,
+      }
+    }
+  }
+  return null
+}
