+    inputTokens,
+    outputTokens,
+    ...sumOptionalUsage(left, right, 'cacheReadTokens'),
+    ...sumOptionalUsage(left, right, 'cacheWriteTokens'),
+    ...sumOptionalUsage(left, right, 'reasoningTokens'),
+    ...sumOptionalUsage(left, right, 'totalTokens'),
+  }
