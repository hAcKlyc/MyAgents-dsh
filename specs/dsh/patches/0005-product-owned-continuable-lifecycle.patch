diff --git a/packages/subagent/subagent/tests/legacy-descriptor.spec.ts b/packages/subagent/subagent/tests/legacy-descriptor.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..51fce255181d95d3119bb3a3f5675a0eb6c8094e
--- /dev/null
+++ b/packages/subagent/subagent/tests/legacy-descriptor.spec.ts
@@ -0,0 +1,84 @@
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { mkdtemp, rm } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { Context } from '@deepseek-ai/cordis'
+import AgentLoop from '@deepseek-ai/dsh-agent-loop'
+import { mountAgentLoopTestDependencies } from '@deepseek-ai/dsh-agent-loop-testkit'
+import { SessionId, type SessionEvent } from '@deepseek-ai/dsh-session'
+import * as JsonlSessionPersistence from '@deepseek-ai/dsh-session-persistence-jsonl'
+import SubagentRuntime, { foldSubagentDescriptor, snapshotSubagentDescriptor } from '../src/index.ts'
+import { queueHostSubagentPrompt } from '../src/internal.ts'
+import { MockAdapter, textResponse } from '../../../core/agent-loop/tests/mock-adapter.ts'
+import { TestSessionQuery } from './test-session-query.ts'
+import { mountWorkingDirectoryFixture } from './working-directory-fixture.ts'
+import { loadStoredSession } from './persistence-helpers.ts'
+
+const cleanups: (() => Promise<void>)[] = []
+afterEach(async () => { for (const cleanup of cleanups.splice(0)) await cleanup() })
+const event = (data: unknown): SessionEvent => ({ type: 'subagent/descriptor', data } as SessionEvent)
+const descriptor = { version: 5, mode: 'continuable' as const, provider: 'native-spawn', label: 'released child',
+  agentProvider: 'mock', agentModel: 'mock' }
+
+async function fixture(data: Record<string, unknown>) {
+  const directory = await mkdtemp(join(tmpdir(), 'dsh-legacy-child-'))
+  const ctx = new Context()
+  cleanups.push(async () => { await ctx.fiber.dispose(); await rm(directory, { recursive: true, force: true }) })
+  await mountAgentLoopTestDependencies(ctx)
+  await ctx.plugin(JsonlSessionPersistence, { root: directory })
+  await ctx.plugin(AgentLoop, { agents: [] })
+  await ctx.plugin(TestSessionQuery)
+  await mountWorkingDirectoryFixture(ctx)
+  await ctx.plugin(SubagentRuntime)
+  const adapter = new MockAdapter([textResponse('resumed legacy child')])
+  ctx.llm.registerAdapter(['mock'], adapter)
+  const parent = await ctx.agentLoop.create(SessionId('legacy-parent'), { provider: 'mock', model: 'mock' })
+  const handle = await ctx.agents.create({ sessionId: SessionId('legacy-child'),
+    meta: { origin: 'subagent', parentSession: parent.id, delegationDepth: 1 },
+    agentOptions: { provider: 'mock', model: 'mock' } })
+  handle.agent.session.append('turn/start', { turn: 1 })
+  handle.agent.session.append('subagent/descriptor', data as never)
+  handle.agent.session.append('turn/end', { turn: 1, reason: { kind: 'completed' } })
+  await ctx.sessions.flush(handle.agent.session)
+  const childId = handle.agent.id
+  await handle.dispose()
+  return { ctx, parent, childId, adapter,
+    send: () => queueHostSubagentPrompt(ctx.subagents, parent, childId,
+      [{ type: 'text', text: 'continue legacy work' }], { kind: 'user' }, new AbortController().signal) }
+}
+
+describe('released MyAgents descriptor compatibility', () => {
+  it('keeps v5 identity and immutable settlement authority while new writes use native v3', () => {
+    expect(foldSubagentDescriptor([event({ ...descriptor, settlementDelivery: 'external' })]))
+      .toEqual({ ...descriptor, settlementDelivery: 'external' })
+    expect(foldSubagentDescriptor([event({ version: 5, mode: 'one-shot', provider: 'spawn' })]))
+      .toEqual({ version: 5, mode: 'one-shot', provider: 'spawn' })
+    expect(snapshotSubagentDescriptor({ mode: 'continuable', provider: 'spawn', label: 'new' }))
+      .toEqual({ version: 3, mode: 'continuable', provider: 'spawn', label: 'new' })
+    expect(foldSubagentDescriptor([event({ ...descriptor, version: 4 })])).toBeUndefined()
+    expect(() => foldSubagentDescriptor([event({ ...descriptor, settlementDelivery: 'caller' })])).toThrow('settlementDelivery')
+    expect(() => foldSubagentDescriptor([event({ ...descriptor, version: 3, settlementDelivery: 'parent' })])).toThrow('unknown field')
+  })
+
+  it.each([undefined, 'parent'] as const)('cold-resumes released native v5 with %s delivery without rewriting history', async (settlementDelivery) => {
+    const data = { ...descriptor, ...(settlementDelivery === undefined ? {} : { settlementDelivery }) }
+    const state = await fixture(data)
+    await state.send()
+    await vi.waitFor(() => { expect(state.ctx.agents.get(state.childId)).toBeUndefined() })
+    const loaded = await loadStoredSession(state.ctx.sessionPersistence, state.childId)
+    expect(loaded.events.filter(row => row.type === 'subagent/descriptor').map(row => row.data)).toEqual([data])
+    expect(loaded.meta.parentSession).toBe(state.parent.id)
+    expect(loaded.meta.delegationDepth).toBe(1)
+    expect(loaded.events.some(row => row.type === 'assistant/message'
+      && row.data.message.content.some(block => block.type === 'text' && block.text === 'resumed legacy child'))).toBe(true)
+  })
+
+  it('keeps external-owner logs readable and refuses execution before materializing or inserting', async () => {
+    const state = await fixture({ ...descriptor, settlementDelivery: 'external' })
+    const before = await loadStoredSession(state.ctx.sessionPersistence, state.childId)
+    await expect(state.send()).rejects.toMatchObject({ code: 'NOT_RESUMABLE', message: expect.stringContaining('read-only') })
+    expect(state.ctx.agents.get(state.childId)).toBeUndefined()
+    expect(state.adapter.requests).toHaveLength(0)
+    expect((await loadStoredSession(state.ctx.sessionPersistence, state.childId)).events).toEqual(before.events)
+  })
+})
