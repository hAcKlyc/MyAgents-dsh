+  it('wakePending latches the same pending identity across aborted-driver convergence', async () => {
+    const adapter = new MockAdapter(['hang-slow', textResponse('recovered reply')])
+    const ctx = await harness(adapter)
+    const agent = await ctx.agentLoop.create(SessionId('wake-pending-abort-window'), { provider: 'mock', model: 'mock' })
+
+    send(agent, 'active')
+    await new Promise(resolve => setTimeout(resolve, 30))
+    const pending = createUserMessage({
+      content: [{ type: 'text', text: 'preserved' }],
+      source: { kind: 'user' },
+    })
+    agent.send(pending, 'next-turn', false)
+    agent.cancel({ kind: 'user' }, { keepInbox: true })
+
+    expect(agent.wakePending?.(pending.id)).toBe(true)
+    await agent.whenIdle()
+
+    expect(userTexts(agent)).toEqual(['active', 'preserved'])
+    expect(adapter.requests).toHaveLength(2)
+    expect(agent.inbox.nextTurn).toHaveLength(0)
+    expect(agent.wakePending?.(pending.id)).toBe(false)
+  })
+
+  it('wakePending preserves queued FIFO and never inserts a durable splice', async () => {
+    const adapter = new MockAdapter([textResponse('reply')])
