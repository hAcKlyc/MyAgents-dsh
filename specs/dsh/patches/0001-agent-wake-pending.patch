+    const first = createUserMessage({ content: [{ type: 'text', text: 'first' }], source: { kind: 'user' } })
+    const second = createUserMessage({ content: [{ type: 'text', text: 'second' }], source: { kind: 'user' } })
+    agent.send(first, 'next-turn', false)
+    agent.send(second, 'next-turn', false)
+    expect(agent.wakePending?.(first.id)).toBe(true)
+    await agent.whenIdle()
+
+    expect(userTexts(agent)).toEqual(['first', 'second'])
+    expect(agent.session.events.some(event => event.type === 'agent/inbox/spliced'
+      && event.data.outcome === 'canceled')).toBe(false)
+    expect(agent.wakePending?.(first.id)).toBe(false)
+  })
+
