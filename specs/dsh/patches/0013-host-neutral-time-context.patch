+it('cold-restores historical unavailable-zone readings without rewriting them', async () => {
+  const legacy = 'Time sampled while preparing turn 1, step 1: 2026-07-14T00:00:00+00:00[UTC]\n'
+    + 'Browser time zone for this request: unavailable. Ask the user to clarify otherwise-unqualified dates and times.\n'
+    + 'Elapsed since the preceding model-visible message: unavailable.'
+  const source = Session.create(SessionId('legacy-time-source'))
+  openMessageTurn(source, 1)
+  source.append('user/message', createUserMessage({ content: [{ type: 'text', text: legacy }],
+    source: { kind: 'time-context', form: 'snapshot', sections: [{ name: 'time-context', text: legacy }] },
+  }), { surfaceOp: 'append' })
+  const resumed = Session.create(SessionId('legacy-time-resumed'), source.snapshotEvents())
+  const { ctx } = await mount({ refreshIntervalMs: 0 })
+  vi.setSystemTime(BASE + 61_000)
+  await fire(ctx, sessionAgent(resumed), 1, 2)
+  expect(contextTexts(resumed)[0]).toBe(legacy)
+  expect(contextTexts(resumed)[1]).not.toContain('Browser time zone')
+  expect(contextTexts(resumed)[1]).toContain('Elapsed since the preceding step context: 1m 1s.')
+  const reading = resumed.snapshotEvents().at(-1)
+  expect(reading?.type === 'user/message' && reading.data.source).toEqual({
+    kind: 'time-context', form: 'snapshot', sections: [{ name: 'time-context', text: contextTexts(resumed)[1] }],
+  })
+  await ctx.fiber.dispose()
+})
