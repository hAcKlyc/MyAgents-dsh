diff --git a/packages/context/time-context/tests/invariant.spec.ts b/packages/context/time-context/tests/invariant.spec.ts
index cba6fc48..fbe9fdf0 100644
--- a/packages/context/time-context/tests/invariant.spec.ts
+++ b/packages/context/time-context/tests/invariant.spec.ts
@@ -347,3 +347,18 @@ describe('time-context invariants', () => {
     }).not.toThrow()
   })
 })
+
+
+it('accepts new host-neutral readings and historical missing-zone readings', async () => {
+  const ctx = await setup()
+  const legacy = reading()
+  const current = legacy.split('\n').filter(line => !line.startsWith('Browser time zone')).join('\n')
+  expect(() => { ctx.emit('session/event', preparing(1, 1), event(current)) }).not.toThrow()
+  expect(() => { ctx.emit('session/event', preparing(1, 1), event(legacy)) }).not.toThrow()
+  expect(() => { ctx.emit('session/event', preparing(1, 1, 'Asia/Shanghai'), event(current)) }).toThrow(/browser-zone/)
+  const mixed = preparing(1, 1, 'Asia/Shanghai')
+  mixed.append('user/message', createUserMessage({ content: [{ type: 'text', text: 'steer' }],
+    source: { kind: 'user', rpcId: 'steer', clientTimeZone: 'America/New_York' } as never,
+  }), { surfaceOp: 'append' })
+  expect(() => { ctx.emit('session/event', mixed, event(current)) }).toThrow(/browser-zone/)
+})
