diff --git a/packages/llm/llm-pi-ai/tests/model-conversation-config.spec.ts b/packages/llm/llm-pi-ai/tests/model-conversation-config.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..68728eaa33a0817dd22843ffe500dba071093dc2
--- /dev/null
+++ b/packages/llm/llm-pi-ai/tests/model-conversation-config.spec.ts
@@ -0,0 +1,140 @@
+/** Exact-model declarations must reach metadata and the same real wire serializer. */
+import { afterEach, describe, expect, it } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import LlmRuntime, { createDeveloperMessage, createMessage, createUserMessage } from '@deepseek-ai/dsh-llm'
+import type { ToolSchema } from '@deepseek-ai/dsh-llm'
+import { PiAiAdapter } from '@deepseek-ai/dsh-llm-pi-ai'
+import { Config, resolveProfiles } from '../src/config.ts'
+import type { Options, PiAiModelCompatProfile } from '../src/config.ts'
+import { memoryAuth } from './auth-double.ts'
+import { assemble } from './assemble.ts'
+import { closeMockServers, mockServer } from './mock-server.ts'
+
+const baseline: ToolSchema = { name: 'read', description: 'Read a file', parameters: { type: 'object', properties: {} } }
+const added: ToolSchema = { name: 'search', description: 'Search files', parameters: { type: 'object', properties: {} } }
+const system = (text: string) => createMessage({ role: 'system', source: { kind: 'system-prompt' }, content: [{ type: 'text', text }] })
+const cases = [
+  { api: 'anthropic-messages', field: 'supportsMidConvoToolChanges', wire: 'tool_addition', mode: 'in-history' },
+  { api: 'openai-completions', field: 'supportsMidConvoToolAdditions', wire: 'tools', mode: 'addition-only' },
+  { api: 'openai-responses', field: 'supportsAdditionalTools', wire: 'additional_tools', mode: 'addition-only' },
+  { api: 'openai-responses', field: 'supportsToolSearch', wire: 'tool_search_output', mode: 'addition-only' },
+] as const
+
+// Match the plugin's settings-to-resolver boundary: clone the readonly snapshot
+// into owned catalog options before resolution.
+const configuredProviders = (input: Parameters<typeof Config>[0]): Options['providers'] =>
+  structuredClone(Config(input).providers.get()) as Options['providers']
+
+afterEach(closeMockServers)
+
+describe('exact-model conversation configuration', () => {
+  it.each(cases)('passes $api/$field from schema through model info into the actual wire', async ({ api, field, wire, mode }) => {
+    const server = await mockServer(Array.from({ length: 4 }, () => ({
+      status: 401, body: JSON.stringify({ error: { message: 'fixture rejection' } }),
+    })))
+    const compat: PiAiModelCompatProfile = { supportsMidConvoSystemMessages: true, [field]: true }
+    const providers = configuredProviders({ providers: { fixture: {
+      api, baseURL: server.url, apiKeyEnv: 'FIXTURE_KEY', transport: 'sse',
+      models: [
+        { id: 'enabled', compat },
+        { id: 'absent' },
+        { id: 'disabled', compat: { supportsMidConvoSystemMessages: false, [field]: false } },
+        { id: 'system-disabled', compat: { supportsMidConvoSystemMessages: false, [field]: true } },
+      ],
+    } } })
+    const profiles = resolveProfiles(providers)
+    const materialized = profiles.get('fixture')?.piProvider?.getModels()
+    expect(materialized?.find(model => model.id === 'enabled')?.compat).toMatchObject(compat)
+    expect(materialized?.find(model => model.id === 'absent')?.compat).toBeUndefined()
+    const ctx = new Context()
+    const runtime = ctx.plugin(LlmRuntime)
+    try {
+      await runtime
+      const adapter = new PiAiAdapter({ profiles: () => profiles, resolveApiKey: () => Promise.resolve('fixture-key'), auth: memoryAuth() })
+      const dispose = ctx.llm.registerAdapter(['fixture'], adapter)
+      try {
+        for (const id of ['enabled', 'absent', 'disabled', 'system-disabled']) {
+          const info = await ctx.llm.resolveModelInfo('fixture', id)
+          expect(info.systemPromptUpdate).toBe(id === 'enabled' ? 'in-history' : undefined)
+          expect(info.toolUpdate).toBe(id === 'enabled' ? mode : undefined)
+          const update = createDeveloperMessage({ source: { kind: 'tool-registry' }, content: [
+            { type: 'text', text: 'Dynamic instructions.' }, { type: 'tool-addition', toolName: added.name },
+          ] })
+          await assemble(ctx, {
+            provider: 'fixture', model: id,
+            messages: [system('initial'), createUserMessage({ source: { kind: 'user' }, content: [{ type: 'text', text: 'first' }] }), system('updated'), update],
+            tools: [baseline, added], toolHistory: { tools: [baseline], updates: [{ messageId: update.id, additions: [added] }] },
+          })
+        }
+      } finally { dispose() }
+    } finally { await runtime.dispose() }
+    expect(server.requests).toHaveLength(4)
+    const [enabled, absent, disabled, systemDisabled] = server.requests as Record<string, unknown>[]
+    expect(enabled).toHaveProperty('model', 'enabled')
+    if (api === 'anthropic-messages') {
