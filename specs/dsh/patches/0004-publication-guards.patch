diff --git a/packages/core/agent-loop/tests/publication-guards.spec.ts b/packages/core/agent-loop/tests/publication-guards.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..62b3429429cd2cbd04311ed5188f92f7e2ef1edc
--- /dev/null
+++ b/packages/core/agent-loop/tests/publication-guards.spec.ts
@@ -0,0 +1,77 @@
+import { Context } from '@deepseek-ai/cordis'
+import AgentRegistry from '@deepseek-ai/dsh-agent'
+import type { Agent } from '@deepseek-ai/dsh-agent'
+import SessionStore, { Session, SessionId } from '@deepseek-ai/dsh-session'
+import { describe, expect, it, vi } from 'vitest'
+
+const stubAgent = (id: string, session: Session): Agent => ({
+  id: SessionId(id),
+  session,
+} as Agent)
+
+describe('publication guards', () => {
+  it('rejects a Session before store mutation and restores stock behavior on dispose', async () => {
+    const ctx = new Context()
+    await ctx.plugin(SessionStore)
+    const allowed = Session.create(SessionId('allowed-session'))
+    const guard = vi.fn((session: Session) => {
+      expect(ctx.sessions.get(session.id)).toBeUndefined()
+      if (session !== allowed) throw new Error('session publication denied')
+    })
+    const disposeGuard = ctx.sessions.setPublicationGuard(guard)
+
+    expect(() => ctx.sessions.create(SessionId('rogue-session'))).toThrow('session publication denied')
+    expect(ctx.sessions.list()).toEqual([])
+    const detach = ctx.sessions.enter(allowed)
+    expect(ctx.sessions.list()).toEqual([allowed])
+    expect(guard).toHaveBeenCalledTimes(2)
+    detach()
+
+    disposeGuard()
+    const stock = ctx.sessions.create(SessionId('stock-session'))
+    expect(ctx.sessions.get(stock.id)).toBe(stock)
+  })
+
+  it('rejects an Agent before registry mutation with exact owner attribution', async () => {
+    const ctx = new Context()
+    await ctx.plugin(AgentRegistry)
+    const allowedSession = Session.create(SessionId('allowed-agent'))
+    const allowed = stubAgent('allowed-agent', allowedSession)
+    const owner = stubAgent('owner', Session.create(SessionId('owner')))
+    const guard = vi.fn((agent: Agent, candidateOwner: Agent | undefined) => {
+      expect(ctx.agents.get(agent.id)).toBeUndefined()
+      if (agent !== allowed || candidateOwner !== owner) throw new Error('agent publication denied')
+    })
+    const disposeGuard = ctx.agents.setPublicationGuard(guard)
+
+    expect(() => ctx.agents.enter(stubAgent('rogue-agent', Session.create(SessionId('rogue-agent'))), undefined))
+      .toThrow('agent publication denied')
+    expect(ctx.agents.list()).toEqual([])
+    const detach = ctx.agents.enter(allowed, owner)
+    expect(ctx.agents.get(allowed.id)).toBe(allowed)
+    expect(guard).toHaveBeenCalledTimes(2)
+    detach()
+
+    disposeGuard()
+    const stock = stubAgent('stock-agent', Session.create(SessionId('stock-agent')))
+    const detachStock = ctx.agents.enter(stock, undefined)
+    expect(ctx.agents.get(stock.id)).toBe(stock)
+    detachStock()
+  })
+
+  it('allows only one guard of each kind and validates the callback', async () => {
+    const ctx = new Context()
+    await ctx.plugin(SessionStore)
+    await ctx.plugin(AgentRegistry)
+    const disposeSession = ctx.sessions.setPublicationGuard(() => undefined)
+    const disposeAgent = ctx.agents.setPublicationGuard(() => undefined)
+
+    expect(() => ctx.sessions.setPublicationGuard(() => undefined)).toThrow(/already registered/)
+    expect(() => ctx.agents.setPublicationGuard(() => undefined)).toThrow(/already registered/)
+    expect(() => ctx.sessions.setPublicationGuard(undefined as never)).toThrow(TypeError)
+    expect(() => ctx.agents.setPublicationGuard(undefined as never)).toThrow(TypeError)
+
+    disposeAgent()
+    disposeSession()
+  })
+})
