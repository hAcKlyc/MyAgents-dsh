+function requiredString(value: unknown, description: string): string {
+  if (typeof value !== 'string' || value.length === 0) {
+    throw new LlmError(`pi-ai Provider content ${description} must be a non-empty string`, 'INVALID_PROVIDER_CONTENT')
+  }
+  return value
+}
+
+function record(value: unknown, description: string): Readonly<Record<string, unknown>> {
+  if (value === null || typeof value !== 'object' || Array.isArray(value)) {
+    throw new LlmError(`pi-ai Provider content ${description} must be an object`, 'INVALID_PROVIDER_CONTENT')
+  }
+  return value as Readonly<Record<string, unknown>>
+}
+
+function toProviderBlock(content: PiProviderToolContent): ProviderToolCallBlock | ProviderToolResultBlock {
+  if (content.type === 'providerToolCall') {
+    return {
+      type: 'provider-tool-call',
+      id: requiredString(content.id, 'call id'),
+      name: requiredString(content.name, 'tool name'),
+      input: record(content.input, 'input'),
+      providerType: requiredString(content.providerType, 'block type'),
+      raw: record(content.raw, 'raw call'),
+    }
+  }
+  return {
+    type: 'provider-tool-result',
+    toolCallId: requiredString(content.toolCallId, 'result correlation id'),
+    providerType: requiredString(content.providerType, 'block type'),
+    content: content.content,
+    ...(content.isError === undefined ? {} : { isError: content.isError }),
+    raw: record(content.raw, 'raw result'),
+  }
+}
