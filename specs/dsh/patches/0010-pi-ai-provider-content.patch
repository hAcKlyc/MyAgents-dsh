+/** Generic Provider-owned content carried by the pi-ai Anthropic Messages adapter. */
+
+import type { AssistantMessage } from '@earendil-works/pi-ai'
+
+export interface ProviderToolCallBlock {
+  type: 'provider-tool-call'
+  id: string
+  name: string
+  input: Readonly<Record<string, unknown>>
+  providerType: string
+  raw: Readonly<Record<string, unknown>>
+}
+
+export interface ProviderToolResultBlock {
+  type: 'provider-tool-result'
+  toolCallId: string
+  providerType: string
+  content: unknown
+  isError?: boolean
+  raw: Readonly<Record<string, unknown>>
+}
+
+declare module '@deepseek-ai/dsh-llm' {
+  interface ContentBlockMap {
+    'provider-tool-call': ProviderToolCallBlock
+    'provider-tool-result': ProviderToolResultBlock
+  }
+}
+
+export interface PiProviderToolCall {
+  type: 'providerToolCall'
+  id: string
+  name: string
+  input: Record<string, unknown>
+  providerType: string
+  raw: Record<string, unknown>
+}
+
+export interface PiProviderToolResult {
+  type: 'providerToolResult'
+  toolCallId: string
+  providerType: string
+  content: unknown
+  isError?: boolean
+  raw: Record<string, unknown>
+}
+
+export type PiProviderToolContent = PiProviderToolCall | PiProviderToolResult
+export type PiAssistantMessage = Omit<AssistantMessage, 'content'> & {
+  content: Array<AssistantMessage['content'][number] | PiProviderToolContent>
+}
+
+export type PiProviderToolEvent =
+  | { type: 'provider_tool_start'; contentIndex: number; partial: PiAssistantMessage }
+  | {
+    type: 'provider_tool_end'
+    contentIndex: number
+    content: PiProviderToolContent
+    partial: PiAssistantMessage
+  }
+
+export function asPiAssistantMessage(message: AssistantMessage): PiAssistantMessage {
+  return message as PiAssistantMessage
+}
