+  for (const dir of ancestorChain(projectRoot, cwd)) {
+    for (const candidate of candidates) {
+      const absolutePath = join(dir, candidate)
+      const probe = await statFile(absolutePath, fileSystem, options.signal)
+      if (probe.kind === 'absent') continue
+      if (probe.kind === 'unavailable') break
+      const result = await loadProbed({
+        absolutePath,
+        displayPath: relativeDisplay(projectRoot, absolutePath),
+        ...probe.info,
+      })
+      if (result === 'empty') continue
+      if (result !== 'unavailable') loaded.push(result)
+      break
+    }
+  }
