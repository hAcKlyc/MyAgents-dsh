+    for (const candidate of candidates) {
+      const absolutePath = join(dir, candidate)
+      const probe = await statFile(absolutePath, fileSystem, options.signal)
+      if (probe.kind === 'absent') continue
+      if (probe.kind === 'unavailable') break
+      const result = await loadProbed({
