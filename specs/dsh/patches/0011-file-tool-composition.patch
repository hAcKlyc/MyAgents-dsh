diff --git a/packages/fs/fs-local/tests/product-composition.spec.ts b/packages/fs/fs-local/tests/product-composition.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..09f51e57f2e2c15ebe943ab3bf99041b8004468f
--- /dev/null
+++ b/packages/fs/fs-local/tests/product-composition.spec.ts
@@ -0,0 +1,60 @@
+import { Context } from '@deepseek-ai/cordis'
+import { afterEach, expect, it } from 'vitest'
+import { mkdtemp, readFile, rm, writeFile, readdir, stat } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { LocalFileSystem, prepareTextEdit } from '../src/index.ts'
+
+const roots: string[] = []
+afterEach(async () => { await Promise.all(roots.splice(0).map(path => rm(path, { recursive: true, force: true }))) })
+
+it.each(['', '\uFEFF'])('previews the exact CRLF bytes and literal replacement count used by editText (%j BOM)', async (bom) => {
+  const root = await mkdtemp(join(tmpdir(), 'dsh-file-composition-'))
+  roots.push(root)
+  const path = join(root, 'file.txt')
+  await writeFile(path, bom + 'alpha\r\nbeta\r\n')
+  const ctx = new Context()
+  try {
+    await ctx.plugin(LocalFileSystem, { cwd: root })
+    const target = await ctx.fs.resolve(path)
+    const edit = { oldString: 'alpha\nbeta', newString: 'ALPHA\nBETA', replaceAll: false }
+    const preview = prepareTextEdit(await readFile(path, 'utf8'), edit, path)
+    expect(preview).toEqual({ content: 'ALPHA\r\nBETA\r\n', replacements: 1 })
+    await ctx.fs.editText(target, edit)
+    expect(await readFile(path, 'utf8')).toBe(preview.content)
+  } finally { await ctx.fiber.dispose() }
+})
+
+it('refuses publication after staging and cleans the private staging directory', async () => {
+  class GuardedFileSystem extends LocalFileSystem {
+    protected override beforePublish(): Promise<void> { return Promise.reject(new Error('publication refused')) }
+  }
+  const root = await mkdtemp(join(tmpdir(), 'dsh-file-composition-'))
+  roots.push(root)
+  const path = join(root, 'file.txt')
+  await writeFile(path, 'original')
+  const ctx = new Context()
+  try {
+    await ctx.plugin(GuardedFileSystem, { cwd: root })
+    const target = await ctx.fs.resolve(path)
+    await expect(ctx.fs.writeText(target, 'changed')).rejects.toThrow('publication refused')
+    await expect(ctx.fs.editText(target, { oldString: 'original', newString: 'changed', replaceAll: false })).rejects.toThrow('publication refused')
+    expect(await readFile(path, 'utf8')).toBe('original')
+    expect(await readdir(root)).toEqual(['file.txt'])
+  } finally { await ctx.fiber.dispose() }
+})
+
+
+it('leaves absent parent creation to the composing journal when createParents is false', async () => {
+  const root = await mkdtemp(join(tmpdir(), 'dsh-file-composition-'))
+  roots.push(root)
+  const path = join(root, 'journal-owned', 'new.txt')
+  const ctx = new Context()
+  try {
+    await ctx.plugin(LocalFileSystem, { cwd: root, createParents: false })
+    const target = await ctx.fs.resolve(path)
+    await expect(ctx.fs.writeText(target, 'new')).rejects.toThrow()
+    await expect(stat(join(root, 'journal-owned'))).rejects.toMatchObject({ code: 'ENOENT' })
+    expect(await readdir(root)).toEqual([])
+  } finally { await ctx.fiber.dispose() }
+})
diff --git a/packages/fs/tool-fs/README.md b/packages/fs/tool-fs/README.md
index 93985eeb21557c6aae3c5738d5ca3bcddcc98050..1c604e683bd14c358202a4b7ce0e70ce6f32364e 100644
--- a/packages/fs/tool-fs/README.md
+++ b/packages/fs/tool-fs/README.md
@@ -136,6 +136,8 @@ Patch preflight reads never emit `fs/observed`. The first preflight operation on
 
 After a mutation rejects with `FS_IO_ERROR`, the executor compares each affected target's version with a fresh `stat`. Unchanged targets mean a known failure; a changed target or failed comparison means `unknown`, which records no observation or change. `FS_ABORTED` is always `unknown`: a cancelled remote request rejects while the provider may still be writing. Execution stops at the first failed or unknown commit, or before an operation whose signal is aborted.
 
+The public file-tool factories return stock definitions without registering them. A deployment can register those definitions inside its permission scope through `ctx.tools`, preserving stock parsing, output and presentation. Factory use does not install prompt guidance; the composing plugin owns that contribution.
+
 </details>
 
 -----
