+/** Prepare the exact stored bytes and match count using the provider's own edit algorithm. */
+export function prepareTextEdit(
+  raw: string,
+  edit: { oldString: string; newString: string; replaceAll: boolean },
+  displayPath: string,
+): { content: string; replacements: number } {
+  if (raw.includes('\0')) throw new FsError(`cannot edit "${displayPath}": binary file`, 'FS_NOT_TEXT')
+  // Match readForEdit decoding, including its UTF-8 BOM handling.
+  const decoded = decodeUtf8(Buffer.from(raw, 'utf8'), 'edit', displayPath)
+  const result = applyLiteralEdit(normalizeLineEndings(decoded), edit.oldString, edit.newString, edit.replaceAll, displayPath)
+  return { content: restoreLineEndings(result.content, detectLineEndings(decoded)), replacements: result.replacements }
+}
