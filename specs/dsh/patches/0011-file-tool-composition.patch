diff --git a/packages/fs/fs-local/tests/product-composition.spec.ts b/packages/fs/fs-local/tests/product-composition.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ca6df2ba883041eea98265edb0d1f7ec9b486ca9
--- /dev/null
+++ b/packages/fs/fs-local/tests/product-composition.spec.ts
@@ -0,0 +1,45 @@
+import { Context } from '@deepseek-ai/cordis'
+import { afterEach, expect, it } from 'vitest'
+import { mkdtemp, readFile, rm, writeFile, readdir } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { LocalFileSystem, prepareTextEdit } from '../src/index.ts'
+
+const roots: string[] = []
+afterEach(async () => { await Promise.all(roots.splice(0).map(path => rm(path, { recursive: true, force: true }))) })
+
+it.each(['', '\uFEFF'])('previews the exact CRLF bytes and literal replacement count used by editText (%j BOM)', async (bom) => {
+  const root = await mkdtemp(join(tmpdir(), 'dsh-file-composition-'))
+  roots.push(root)
+  const path = join(root, 'file.txt')
+  await writeFile(path, bom + 'alpha\r\nbeta\r\n')
+  const ctx = new Context()
+  try {
+    await ctx.plugin(LocalFileSystem, { cwd: root })
+    const target = await ctx.fs.resolve(path)
+    const edit = { oldString: 'alpha\nbeta', newString: 'ALPHA\nBETA', replaceAll: false }
+    const preview = prepareTextEdit(await readFile(path, 'utf8'), edit, path)
+    expect(preview).toEqual({ content: 'ALPHA\r\nBETA\r\n', replacements: 1 })
+    await ctx.fs.editText(target, edit)
+    expect(await readFile(path, 'utf8')).toBe(preview.content)
+  } finally { await ctx.fiber.dispose() }
+})
+
+it('refuses publication after staging and cleans the private staging directory', async () => {
+  class GuardedFileSystem extends LocalFileSystem {
+    protected override beforePublish(): Promise<void> { return Promise.reject(new Error('publication refused')) }
+  }
+  const root = await mkdtemp(join(tmpdir(), 'dsh-file-composition-'))
+  roots.push(root)
+  const path = join(root, 'file.txt')
+  await writeFile(path, 'original')
+  const ctx = new Context()
+  try {
+    await ctx.plugin(GuardedFileSystem, { cwd: root })
+    const target = await ctx.fs.resolve(path)
+    await expect(ctx.fs.writeText(target, 'changed')).rejects.toThrow('publication refused')
+    await expect(ctx.fs.editText(target, { oldString: 'original', newString: 'changed', replaceAll: false })).rejects.toThrow('publication refused')
+    expect(await readFile(path, 'utf8')).toBe('original')
+    expect(await readdir(root)).toEqual(['file.txt'])
+  } finally { await ctx.fiber.dispose() }
+})
