+describe('PersistenceCoordinator product known-event predicate', () => {
+  async function mount(backend: ControlledBackend, acceptProduct: boolean) {
+    const ctx = new Context()
+    await ctx.plugin(SessionStore)
+    let coordinator!: PersistenceCoordinator<never>
+    const fiber = await ctx.plugin(Object.assign((inner: Context) => {
+      coordinator = new PersistenceCoordinator(inner, backend, {
+        preparedSessionCacheSize: DEFAULT_PREPARED_SESSION_CACHE_SIZE,
+        writeBatchMaxDelayMs: DEFAULT_WRITE_BATCH_MAX_DELAY_MS,
+        ...(acceptProduct
+          ? { isKnownEventType: (type: string) => KNOWN_SESSION_EVENT_TYPES.has(type) || type === 'myagents/test-required' }
+          : {}),
+      })
+    }, { inject: ['sessions'] }))
+    return { ctx, coordinator, fiber }
+  }
+
+  it('keeps omitted-option stock refusal byte-equivalent', async () => {
+    const backend = new ControlledBackend()
+    const mounted = await mount(backend, false)
+    const id = SessionId('product-event-default-refusal')
+    try {
+      await mounted.coordinator.create(meta(id))
+      await expect(mounted.coordinator.append(id, [productRequiredEvent()])).resolves.toBeUndefined()
+      await expect(mounted.coordinator.inspect(id))
+        .rejects.toThrow(/event type "myagents\/test-required".*unknown/)
+      expect(backend.store.get(id)?.events).toHaveLength(1)
+    } finally {
+      await mounted.fiber.dispose()
+      await mounted.ctx.fiber.dispose()
+    }
+  })
+
