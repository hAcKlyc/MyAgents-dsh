diff --git a/packages/session/session-persistence-jsonl/tests/extension-event-admission.spec.ts b/packages/session/session-persistence-jsonl/tests/extension-event-admission.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..adc993a45499361ce5f7053330f6917c613a8f73
--- /dev/null
+++ b/packages/session/session-persistence-jsonl/tests/extension-event-admission.spec.ts
@@ -0,0 +1,80 @@
+import { Context } from '@deepseek-ai/cordis'
+import { SESSION_FORMAT_VERSION, SessionId } from '@deepseek-ai/dsh-session'
+import * as Jsonl from '@deepseek-ai/dsh-session-persistence-jsonl'
+import { mkdir, mkdtemp, readFile, rm, writeFile } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { dirname, join } from 'node:path'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { generationLogPath } from '../src/format.ts'
+
+declare module '@deepseek-ai/dsh-session' {
+  interface SessionEventMap { 'fixture/required': { revision: string } }
+}
+
+const id = SessionId('extension-admission')
+const header = { type: 'session', version: SESSION_FORMAT_VERSION, id, createdAt: 1000, isSeeded: false, delegationDepth: 0 }
+
+describe('trusted stored extension validation', () => {
+  let root: string
+  let ctx: Context
+  const validate = vi.fn<Jsonl.StoredEventExtensionValidator>((event) => {
+    if (event.type !== 'fixture/required') return false
+    expect(Object.isFrozen(event)).toBe(true)
+    expect(Object.isFrozen(event.data)).toBe(true)
+    if ((event.data as { revision?: unknown }).revision !== 'valid') throw new Error('invalid fixture revision')
+    return true
+  })
+
+  beforeEach(async () => {
+    validate.mockClear()
+    root = await mkdtemp(join(tmpdir(), 'dsh-extension-admission-'))
+    ctx = new Context()
+    await ctx.plugin(Jsonl.withStoredEventValidation(validate), { root, compression: 'none' })
+  })
+  afterEach(async () => {
+    try { await ctx.fiber.dispose() }
+    finally { await rm(root, { recursive: true, force: true }) }
+  })
+
+  async function store(event: object): Promise<string> {
+    const path = generationLogPath(root, undefined, id, SESSION_FORMAT_VERSION, 'none')
+    await mkdir(dirname(path), { recursive: true })
+    await writeFile(path, [header, event].map(row => JSON.stringify(row)).join('\n') + '\n')
+    return path
+  }
+
+  it('cold restores a required extension without weakening native unknown-event admission', async () => {
+    const event = { type: 'fixture/required', seq: 0, time: 1, data: { revision: 'valid' } }
+    await store(event)
+    const handle = await ctx.sessionPersistence.open(id, 'read')
+    try { expect((await handle.read()).events).toEqual([event]) }
+    finally { await handle.close() }
+    expect(validate).toHaveBeenCalledTimes(1)
+  })
+
+  it.each([false, true])('refuses malformed recognized extension even with ignorable=%s', async (ignorable) => {
+    const path = await store({ type: 'fixture/required', seq: 0, time: 1, data: { revision: 'bad' }, ...(ignorable ? { ignorable } : {}) })
+    const bytes = await readFile(path)
+    await expect(ctx.sessionPersistence.open(id, 'write')).rejects.toThrow('stored extension Session event failed validation')
+    expect(await readFile(path)).toEqual(bytes)
+  })
+
+  it('keeps an unknown required event fail-closed', async () => {
+    await store({ type: 'future/required', seq: 0, time: 1, data: {} })
+    await expect(ctx.sessionPersistence.open(id, 'read')).rejects.toThrow('unknown to this harness and not marked ignorable')
+  })
+
+  it('retains an unknown ignorable event', async () => {
+    const event = { type: 'future/optional', seq: 0, time: 1, data: {}, ignorable: true }
+    await store(event)
+    const handle = await ctx.sessionPersistence.open(id, 'read')
+    try { expect((await handle.read()).events).toEqual([event]) }
+    finally { await handle.close() }
+  })
+
+  it('never lets an extension callback bypass native refusal', async () => {
+    await store({ type: 'request/header', seq: 0, time: 1, data: { reason: 'fallback', header: { config: { provider: 'mock', model: 'mock' } } } })
+    await expect(ctx.sessionPersistence.open(id, 'read')).rejects.toThrow('request/header is outside an open turn')
+    expect(validate).not.toHaveBeenCalled()
+  })
+})
