+import { afterEach, describe, expect, it } from 'vitest'
+import { mkdtemp, rm } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { Context } from '@deepseek-ai/cordis'
+import AgentRegistry, {
+  type Agent,
+  type PreparedAssistantCommit,
+  type PreparedAssistantToolCall,
+} from '@deepseek-ai/dsh-agent'
+import AgentLoop from '@deepseek-ai/dsh-agent-loop'
+import LlmRuntime, {
+  ToolCallId,
+  createUserMessage,
+  freezeMessage,
+  type AssistantMessage,
+  type StreamChunk,
+  type ToolCallBlock,
+} from '@deepseek-ai/dsh-llm'
+import SessionStore, { Session, SessionId } from '@deepseek-ai/dsh-session'
+import { snapshotJsonValue, type JsonValue } from '@deepseek-ai/dsh-util-values'
+import SessionProjectionRegistry from '@deepseek-ai/dsh-session-projection'
+import JsonlSessionPersistence from '@deepseek-ai/dsh-session-persistence-jsonl'
+import SystemPrompt from '@deepseek-ai/dsh-system-prompt'
+import ToolRuntime, { defineContentToolFixture } from '@deepseek-ai/dsh-tools'
+import { maxTokensResponse, MockAdapter, textResponse, toolCallResponse } from './mock-adapter.ts'
+
+const contexts: Context[] = []
+const directories: string[] = []
+afterEach(async () => {
+  for (const ctx of contexts.splice(0).reverse()) await ctx.fiber.dispose()
+  for (const path of directories.splice(0)) await rm(path, { recursive: true, force: true })
+})
+
+async function harness(adapter: MockAdapter, root?: string): Promise<Context> {
+  const ctx = new Context()
+  contexts.push(ctx)
+  await ctx.plugin(LlmRuntime)
+  await ctx.plugin(SessionStore)
+  if (root !== undefined) await ctx.plugin(JsonlSessionPersistence, { root, compression: 'none' })
+  await ctx.plugin(SessionProjectionRegistry)
+  await ctx.plugin(SystemPrompt)
+  await ctx.plugin(ToolRuntime)
+  await ctx.plugin(AgentRegistry)
+  await ctx.plugin(AgentLoop, { agents: [] })
+  ctx.llm.registerAdapter(['mock'], adapter)
+  return ctx
+}
+
+function send(agent: Agent): void {
+  agent.followup(createUserMessage({
+    content: [{ type: 'text', text: 'run tools' }],
+    source: { kind: 'user' },
+  }))
+}
+
+function parallelToolResponse(): StreamChunk[] {
+  return [
+    { type: 'block-start', index: 0, blockType: 'tool-call' },
+    { type: 'tool-call-delta', index: 0, id: ToolCallId('call-a'), name: 'read', argumentsDelta: '{"path":"old-a"}' },
+    { type: 'block-end', index: 0, block: { type: 'tool-call', id: ToolCallId('call-a'), name: 'read', arguments: '{"path":"old-a"}' } },
+    { type: 'block-start', index: 1, blockType: 'tool-call' },
+    { type: 'tool-call-delta', index: 1, id: ToolCallId('call-b'), name: 'write', argumentsDelta: '{"path":"old-b","content":"old"}' },
+    { type: 'block-end', index: 1, block: { type: 'tool-call', id: ToolCallId('call-b'), name: 'write', arguments: '{"path":"old-b","content":"old"}' } },
+    { type: 'usage', usage: { inputTokens: 10, outputTokens: 10 } },
+    { type: 'finish', reason: { kind: 'tool-calls' } },
+  ]
+}
+
+function replaceArguments(
+  commit: PreparedAssistantCommit,
+  values: Readonly<Record<string, JsonValue>>,
+): PreparedAssistantCommit {
+  const message = freezeMessage({
+    id: commit.message.id,
+    role: 'assistant',
+    source: commit.message.source,
+    content: commit.message.content.map(block => block.type === 'tool-call'
+      ? { ...block, arguments: JSON.stringify(values[block.name]) }
+      : block),
+  })
+  const toolCalls = message.content
+    .filter((block): block is ToolCallBlock => block.type === 'tool-call')
+    .map((block): PreparedAssistantToolCall => Object.freeze({
+      callId: block.id,
+      name: block.name,
+      rawArguments: block.arguments,
+      parsedArguments: snapshotJsonValue(JSON.parse(block.arguments)) as JsonValue,
+    }))
+  return Object.freeze({ message, toolCalls: Object.freeze(toolCalls) })
+}
+
+describe('agent/pre-assistant-commit', () => {
+  it('makes transformed multi-call input authoritative through history, permission, execution, result, and resume', async () => {
+    const root = await mkdtemp(join(tmpdir(), 'dsh-pre-assistant-commit-'))
