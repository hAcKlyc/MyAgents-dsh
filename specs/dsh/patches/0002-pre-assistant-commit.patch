+function ownDataKeys(value: unknown): string[] {
+  if (typeof value !== 'object' || value === null) throw new TypeError('expected immutable data object')
+  const keys = Reflect.ownKeys(value)
+  if (keys.some(key => typeof key !== 'string')) throw new TypeError('symbol data keys are forbidden')
+  for (const key of keys) {
+    const descriptor = Object.getOwnPropertyDescriptor(value, key)
+    if (descriptor === undefined || !('value' in descriptor)) throw new TypeError('accessor data keys are forbidden')
+  }
+  return (keys as string[]).sort()
