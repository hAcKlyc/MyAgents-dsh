+      if (commit.toolCalls.length === 0) return inherited
+      seen.push('revision-b')
+      return replaceArguments(inherited, { echo: { text: 'revision-b' } })
+    })
+    release.resolve(undefined)
+    await agent.whenIdle()
+
+    expect(seen.slice(0, 2)).toEqual(['revision-a', 'execute:revision-a'])
+    expect(seen).not.toContain('execute:revision-b')
+  })
+})
