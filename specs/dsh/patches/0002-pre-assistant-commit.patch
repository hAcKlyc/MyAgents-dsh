+/** Derive scheduling inputs exclusively from one assistant message. */
+function preparedAssistantCommit(message: AssistantMessage): PreparedAssistantCommit {
+  const toolCalls = message.content
+    .filter((block): block is ToolCallBlock => block.type === 'tool-call')
+    .map(block => Object.freeze({
+      callId: block.id,
+      name: block.name,
+      rawArguments: block.arguments,
+      parsedArguments: parsePreparedArguments(block),
+    }))
