+function parsePreparedArguments(block: ToolCallBlock): PreparedAssistantToolCall['parsedArguments'] {
+  let parsed: unknown
+  try {
+    parsed = block.arguments ? JSON.parse(block.arguments) : {}
+  } catch {
+    parsed = block.arguments
+  }
+  const snapshot = snapshotJsonValue(parsed)
