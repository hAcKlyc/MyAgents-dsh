+    expect(resultIds).toEqual([ToolCallId('call-a'), ToolCallId('call-b')])
+    const authoritativeLog = JSON.stringify(agent.session.snapshotEvents().filter(event =>
+      event.type === 'assistant/message' || event.type === 'tool/call' || event.type === 'tool/result')
+      .map(event => event.type === 'assistant/message' ? event.data.message : event.data))
+    const sourceStreams = JSON.stringify(agent.session.snapshotEvents()
+      .filter(event => event.type === 'assistant/message').map(event => event.data.stream))
+    expect(sourceStreams).toContain('old-a')
+    expect(sourceStreams).toContain('old-b')
+    expect(authoritativeLog).not.toContain('old-a')
+    expect(authoritativeLog).not.toContain('old-b')
+    const resumed = Session.create(SessionId('pre-commit-resumed'), agent.session.snapshotEvents())
+    expect(JSON.stringify(resumed.deriveMessages())).not.toContain('old-a')
+    expect(JSON.stringify(resumed.deriveMessages())).toContain('published')
+    await ctx.sessions.flush(agent.session)
+    const originalEvents = agent.session.snapshotEvents()
+    await ctx.fiber.dispose()
+    const coldAdapter = new MockAdapter([textResponse('continued')])
+    const cold = await harness(coldAdapter, root)
+    const handle = await cold.agents.resume({
+      resumeSessionId: agent.id, agentOptions: { provider: 'mock', model: 'mock' },
+    })
+    expect(handle.agent.session.snapshotEvents().slice(0, originalEvents.length)).toEqual(originalEvents)
+    expect(handle.agent.session.snapshotEvents().slice(originalEvents.length))
+      .toEqual([expect.objectContaining({ type: 'session/end-seed', data: {} })])
+    send(handle.agent)
+    await handle.agent.whenIdle()
+    expect(coldAdapter.requests).toHaveLength(1)
