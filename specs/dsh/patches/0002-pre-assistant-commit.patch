+        async execute(input) {
+          executions.push(input)
+          return [{ type: 'text', text: 'ok' }]
+        },
+      }))
+    }
+    ctx.on('agent/pre-assistant-commit', async ({ commit }, next) => {
+      const inherited = await next()
+      if (commit.toolCalls.length === 0) return inherited
+      preparedOrder.push(...commit.toolCalls.map(call => call.name))
+      return replaceArguments(inherited, {
+        read: { path: 'new-a' },
+        write: { path: 'new-b', content: 'published' },
+      })
+    })
+    ctx.on('tools/pre-execute', async (execution, next) => {
